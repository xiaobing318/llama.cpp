{
  "agent_host": "127.0.0.1",
  "agent_port": 8081,
  "llama_server_host": "127.0.0.1",
  "llama_server_port": 8080,
  "llama_server_path": "F:/llama.cpp-data/llama-b5215-bin-win-cuda-cu12.4-x64/llama-server.exe",
  "model_path": "F:/llama.cpp-data/models/qwen2.5-1.5b-instruct-q8_0.gguf",
  "n_ctx": 2048,
  "n_gpu_layers": 99,
  "auto_start_server": true,
  "tools": [
    {
      "type": "function",
      "executable": "ogr2ogr",
      "executable_windows": "D:/yxb/garbage_data/DLHJ_20250207-1/DLHJ/bin/ogr2ogr.exe",
      "executable_linux": "/usr/bin/ogr2ogr",
      "function": {
        "name": "ogr_convert_format",
        "description": "转换矢量数据格式（如SHP到GeoJSON），支持多种输入输出格式",
        "parameters": {
          "type": "object",
          "properties": {
            "input_file": {
              "type": "string",
              "description": "输入矢量文件路径，支持格式：Shapefile(.shp), GeoJSON(.geojson), KML(.kml), GPX(.gpx), GML(.gml), CSV(.csv)等",
              "minLength": 1,
              "pattern": "^.*\\.(shp|geojson|json|kml|gpx|gml|csv|tab|dxf)$"
            },
            "output_file": {
              "type": "string",
              "description": "输出文件路径，扩展名决定输出格式",
              "minLength": 1
            },
            "output_format": {
              "type": "string",
              "description": "输出格式驱动名称",
              "enum": [ "GeoJSON", "ESRI Shapefile", "KML", "GPX", "GML", "CSV", "MapInfo File", "DXF", "GPKG" ],
              "default": "GeoJSON"
            },
            "overwrite": {
              "type": "boolean",
              "description": "是否覆盖已存在的输出文件",
              "default": false
            },
            "encoding": {
              "type": "string",
              "description": "字符编码",
              "enum": [ "UTF-8", "GBK", "GB2312", "ISO-8859-1" ],
              "default": "UTF-8"
            }
          },
          "required": [ "input_file", "output_file", "output_format", "overwrite", "encoding" ],
          "additionalProperties": false
        }
      },
      "command_template": "ogr2ogr {overwrite:?-overwrite} -f \"{output_format}\" \"{output_file}\" \"{input_file}\" {encoding:?-lco ENCODING={encoding}}"
    }
  ]
}