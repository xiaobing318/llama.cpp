            "function": {
                "name": "ogr_convert_format",
                "description": "Convert a vector dataset to another format using ogr2ogr. This does not change the geometry or CRS unless other options are specified.\n\nWHEN TO USE:\nUse for simple format conversions or field subsetting. Do not use for reprojection or spatial clipping (use dedicated tools).",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "input_file": {
                            "type": "string",
                            "description": "Path to the source vector dataset (e.g., .shp, .gpkg, .geojson)."
                        },
                        "output_file": {
                            "type": "string",
                            "description": "Path to the destination dataset to create."
                        },
                        "output_format": {
                            "type": "string",
                            "description": "GDAL/OGR output driver name.",
                            "enum": [
                                "GPKG",
                                "ESRI Shapefile",
                                "GeoJSON",
                                "FlatGeobuf",
                                "CSV"
                            ],
                            "default": "GPKG"
                        },
                        "overwrite": {
                            "type": "boolean",
                            "description": "Overwrite existing output.",
                            "default": false
                        },
                        "nln": {
                            "type": "string",
                            "description": "New layer name for the destination dataset.",
                            "default": ""
                        },
                        "select": {
                            "type": "string",
                            "description": "Comma-separated list of fields to copy (use quotes around names with spaces).",
                            "default": ""
                        },
                        "where": {
                            "type": "string",
                            "description": "Attribute filter expressed like an SQL WHERE clause.",
                            "default": ""
                        }
                    },
                    "required": [
                        "input_file",
                        "output_file",
                        "output_format"
                    ],
                    "additionalProperties": false
                }
            },
            "command_template": "executableFilePath {overwrite:?-overwrite} -f \"{output_format}\" {nln:?-nln \"{nln}\"} {select:?-select \"{select}\"} {where:?-where \"{where}\"} \"{output_file}\" \"{input_file}\"",
            "examples": [
                {
                    "args": {
                        "input_file": "in.shp",
                        "output_file": "out.gpkg",
                        "output_format": "GPKG",
                        "overwrite": true
                    }
                },
                {
                    "args": {
                        "input_file": "roads.geojson",
                        "output_file": "roads.fgb",
                        "output_format": "FlatGeobuf",
                        "select": "id,name"
                    }
                }
            ]
        },
