            "type": "function",
            "executable": "shapefile_converter",
            "executable_windows": "F:/starmap_package/DLHJ_20250812/DLHJ/bin/shapefile_converter.exe",
            "executable_linux": "/usr/local/bin/shapefile_converter",
            "function": {
                "name": "shapefile_converter",
                "description": "Convert ESRI Shapefile attribute text encoding (e.g., GBK/GB2312) to UTF-8 (or another target encoding). Supports single-file conversion or batch/recursive directory processing, and automatically handles companion files (.shx, .dbf, .prj, etc.). WHEN TO USE: apply when Shapefile labels/attributes show garbled characters due to mismatched code pages; prefer this tool for bulk folder conversion.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "input_path": {
                            "type": "string",
                            "description": "Path to a Shapefile (.shp) or a directory containing Shapefiles. If a directory is provided, all *.shp files inside are processed.",
                            "minLength": 1
                        },
                        "output_path": {
                            "type": "string",
                            "description": "Optional destination path. If input is a file, this may be a target .shp path; if input is a folder, this may be an output folder. If omitted, outputs are written alongside inputs with a _utf8 suffix."
                        },
                        "r_flag": {
                            "type": "string",
                            "description": "Add -r flag for recursive processing",
                            "enum": [
                                "-r"
                            ]
                        },
                        "s_flag": {
                            "type": "string",
                            "description": "Add -s flag for source encoding",
                            "enum": [
                                "-s"
                            ],
                            "default": "-s"
                        },
                        "source_encoding": {
                            "type": "string",
                            "description": "Source encoding name for DBF attributes. Typical values: GBK, GB2312, CP936.",
                            "minLength": 2,
                            "maxLength": 40,
                            "pattern": "^[A-Za-z0-9.-]+$",
                            "default": "GBK"
                        },
                        "t_flag": {
                            "type": "string",
                            "description": "Add -t flag for target encoding",
                            "enum": [
                                "-t"
                            ],
                            "default": "-t"
                        },
                        "target_encoding": {
                            "type": "string",
                            "description": "Target encoding name. Common values: UTF-8, ASCII, etc.",
                            "minLength": 2,
                            "maxLength": 40,
                            "pattern": "^[A-Za-z0-9.-]+$",
                            "default": "UTF-8"
                        },
                        "v_flag": {
                            "type": "string",
                            "description": "Add -v flag for verbose output",
                            "enum": [
                                "-v"
                            ]
                        }
                    },
                    "required": [
                        "input_path",
                        "s_flag",
                        "t_flag"
                    ],
                    "additionalProperties": false
                }
            },
            "command_template": "shapefile_converter {r_flag} {s_flag} {source_encoding} {t_flag} {target_encoding} {v_flag} \"{input_path}\" {output_path}"
        },
        {
            "type": "function",
            "executable": "ogrinfo",
            "executable_windows": "F:/starmap_package/DLHJ_20250812/DLHJ/bin/ogrinfo.exe",
            "executable_linux": "/usr/bin/ogrinfo",
            "function": {
                "name": "ogr_info_basic",
                "description": "Checks for vector data sources supported by OGR. Typically used to list layers or print summary information. This tool is useful for reprojecting a single shapefile or multiple shapefiles (organized as directories), converting data formats, and obtaining information such as the coordinate reference system, projected coordinate system, schema, feature count, and spatial extent. It is best suited for data validation, preprocessing, and pipeline inspection. Using summary mode (-so) can improve efficiency.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "dataset": {
                            "type": "string",
                            "description": "Required. The datasource path (file, directory, or database connection string). Examples: Shapefile (.shp), GeoPackage (.gpkg), FileGDB, PostGIS connection."
                        },
                        "list_all_layers": {
                            "type": "string",
                            "description": "If true, enables -al (all layers). Lists all layers in the datasource. When combined with -so, prints only summary information for each layer instead of dumping all features.",
                            "default": "-al"
                        },
                        "summary_only": {
                            "type": "string",
                            "description": "If true, enables -so (summary only). Prints only summary information (projection, schema, feature count, extent). Recommended for large datasets to avoid excessive feature dumps.",
                            "default": "-so"
                        }
                    },
                    "required": [
                        "dataset",
                        "list_all_layers",
                        "summary_only"
                    ],
                    "additionalProperties": false
                }
            },
            "command_template": "executableFilePath {list_all_layers} {summary_only} \"{dataset}\""
        },
        {
