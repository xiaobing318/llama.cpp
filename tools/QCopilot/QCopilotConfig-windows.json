                "description": "Convert a vector dataset from one format to another without changing CRS/geometry. WHEN TO USE: simple format conversion (e.g., SHP ⇄ GPKG ⇄ GeoJSON).",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "input_file": {
                            "type": "string",
                            "description": "Input datasource path.",
                            "minLength": 1
                        },
                        "output_file": {
                            "type": "string",
                            "description": "Output datasource path.",
                            "minLength": 1
                        },
                        "output_format": {
                            "type": "string",
                            "description": "GDAL output driver name (-f).",
                            "enum": [
                                "GPKG",
                                "ESRI Shapefile",
                                "GeoJSON",
                                "MapInfo File",
                                "CSV",
                                "KML",
                                "GML",
                                "DXF"
                            ],
                            "default": "GPKG"
                        },
                        "overwrite_flag": {
                            "type": "string",
                            "description": "Replace existing output layer/dataset if present.",
                            "enum": [
                                "-overwrite"
