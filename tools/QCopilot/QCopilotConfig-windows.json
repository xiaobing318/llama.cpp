                            "default": "-overwrite"
                        },
                        "lco_encoding_flag": {
                            "type": "string",
                            "description": "Pass ENCODING layer creation option when supported (e.g., Shapefile/CSV).",
                            "enum": [
                                "-lco"
                            ],
                            "default": "-lco"
                        },
                        "encoding": {
                            "type": "string",
                            "description": "Target text encoding value for -lco ENCODING=...",
                            "enum": [
                                "UTF-8",
                                "GBK",
                                "GB2312",
                                "ISO-8859-1"
                            ],
                            "default": "UTF-8"
                        },
                        "oo_encoding_flag": {
                            "type": "string",
                            "enum": [
                                "-oo"
                            ],
                            "description": "Pass ENCODING open option for input driver when supported (e.g., Shapefile/CSV).",
                            "default": "-oo"
                        },
                        "source_encoding": {
                            "type": "string",
                            "description": "Source text encoding value for -oo ENCODING=...",
                            "enum": [
                                "UTF-8",
                                "GBK",
                                "GB2312",
                                "ISO-8859-1"
                            ],
                            "default": "UTF-8"
                        }
                    },
                    "required": [
                        "input_file",
                        "output_file",
                        "output_format",
                        "overwrite_flag",
                        "lco_encoding_flag",
                        "encoding",
                        "oo_encoding_flag",
                        "source_encoding"
                    ],
                    "additionalProperties": false
                }
            },
            "command_template": "executableFilePath {overwrite_flag} -f \"{output_format}\" {lco_encoding_flag} ENCODING={encoding} {oo_encoding_flag} ENCODING={source_encoding} \"{output_file}\" \"{input_file}\""
        },
