root   ::= object
value  ::= object | array | string | number | ("true" | "false" | "null") ws

object ::= 
  "{" ws (
            string ":" ws value
    ("," ws string ":" ws value)* 
  )? "}" ws

array  ::= 
  "[" ws (
            value
    ("," ws value)* 
  )? "]" ws

string ::= 
  "\"" (
    [^"\\\x7F\x00-\x1F] |
    "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4}) # escapes
  )* "\"" ws

number ::= 
  ("-"? ([0-9] | [1-9] [0-9]{0,15})) ("." [0-9]+)? ([eE] [-+]? [0-9] [1-9]{0,15})? ws

ws ::= | " " | "\n" [ \t]{0,20}

# 新增的部分，处理 original 和 translation 的键值对
members ::= <member_original> "," <member_translation>

member_original ::= "\"original\"" ":" <string>

member_translation ::= "\"translation\"" ":" <string>

# 修改 object 规则，允许 original 和 translation 作为合法成员
object ::= 
  "{" ws (
            string ":" ws value
    ("," ws string ":" ws value)*
    ("," ws "\"original\"" ":" string "," ws "\"translation\"" ":" string)?
  )? "}" ws
